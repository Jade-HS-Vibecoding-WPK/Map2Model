<Project Sdk="Microsoft.NET.Sdk">
  <!-- Map2Model-Add-in für Revit 2026. Bauen: dotnet build -c Release -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Map2ModelRevit</AssemblyName>
    <RootNamespace>Map2ModelRevit</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RevitOrdner>C:\Program Files\Autodesk\Revit 2026</RevitOrdner>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitOrdner)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitOrdner)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
